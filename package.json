{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "[ -f .env ] && . ./.env; ng serve --define \"PRIMEUI_LICENSE='$PRIMEUI_LICENSE'\"",
    "build": "[ -f .env ] && . ./.env; [ -n \"$PRIMEUI_LICENSE\" ] || { echo \"PRIMEUI_LICENSE is not set: add it to .env or the build environment.\" >&2; exit 1; }; ng build --define \"PRIMEUI_LICENSE='$PRIMEUI_LICENSE'\"",
    "watch": "[ -f .env ] && . ./.env; ng build --watch --configuration development --define \"PRIMEUI_LICENSE='$PRIMEUI_LICENSE'\"",
    "test": "ng test",
    "deploy": "npm run build && wrangler deploy",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@primeicons/angular": "^8.0.2",
    "@primeuix/themes": "^3.0.1",
    "primeng": "^22.1.2",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true
  }
}
