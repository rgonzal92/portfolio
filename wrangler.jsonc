{
  "name": "portfolio",
  "compatibility_date": "2026-09-29",
  // Served only at rgonz.dev; www.rgonz.dev 301s here through a Cloudflare redirect rule.
  "routes": [{ "pattern": "rgonz.dev", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./dist/portfolio/browser",
    "not_found_handling": "single-page-application",
  },
}
